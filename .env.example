# Host-side translation only. Never package translation credentials into the APK.
PAWVERIO_TRANSLATION_URL=
PAWVERIO_TRANSLATION_KEY=
# Amazon SKU is configured in platform/AmazonBilling.kt; actual price comes from store.
# Place Amazon-issued public authentication key via private build setup; never add developer API secrets.
# Production signing passwords belong in local environment/CI secrets, never this file.
PAWVERIO_KEYSTORE_PATH=
PAWVERIO_KEY_ALIAS=
PAWVERIO_STORE_PASSWORD=
PAWVERIO_KEY_PASSWORD=

